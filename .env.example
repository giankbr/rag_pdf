APP_NAME=RAG PDF Chatbot
APP_ENV=dev
APP_PORT=8010

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=rag_pdf

# Ganti sesuai provider LLM/embedding yang lo pakai
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=qwen2.5:3b
RAG_TOP_K=2
RAG_MIN_SCORE=0.45
FAQ_MIN_SCORE=0.7
RAG_MAX_CONTEXT_CHARS=1400
OLLAMA_NUM_PREDICT=140
OLLAMA_TEMPERATURE=0.2

# Untuk provider chat OpenAI-compatible (opsional)
# Contoh host lokal: http://127.0.0.1:1234/v1
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_COMPAT_API_KEY=your_api_key_here
OPENAI_COMPAT_MODEL=qwen/qwen3.5-35b-a3b
OPENAI_COMPAT_EMBED_MODEL=text-embedding-3-small
